#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
gts (原 gitq) — 跨 Gitea 镜像的全量检索与 FTS5 文档搜索 (CLI)

说明：
    本项目原名为 gitq，为统一工具风格与作为通用插件交付，正式重命名为 gts (Gitea Search)。
    保留 gitq 和 dsh-search 作为兼容别名。

检索模式：
    1. FTS5 全文模式 (-D / --doc / --query)：毫秒级全文检索文档、会话、配置、脚本。
    2. Git 源码模式 (默认)：跨全部镜像仓与本地分支搜索代码内容、路径与提交。

用法示例：
    gts -D "沙盒机制"                      # FTS5 全文检索文档与会话
    gts -D --kind doc,script "反向代理"     # 按类型软分区过滤
    gts dockge                            # 源码内容搜索
    gts -p 'install-wizard'               # 搜文件路径
    gts --repos                           # 列出镜像中的仓
"""
import argparse
import fnmatch
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time
from concurrent.futures import ThreadPoolExecutor

# 动态探测引入 indexer 模块（用 realpath 解析 /usr/local/bin/gts 软链，支持同级 bin/、上级 gitea-search/ 或 lib/）
_CUR_DIR = os.path.dirname(os.path.realpath(__file__))
_SEARCH_PATHS = [
    _CUR_DIR,
    os.path.join(_CUR_DIR, "..", "gitea-search"),
    os.path.join(_CUR_DIR, "..", "lib"),
]
for p in _SEARCH_PATHS:
    norm = os.path.normpath(p)
    if norm not in sys.path and os.path.isdir(norm):
        sys.path.insert(0, norm)

# mirror_state 位于 lib/，必须在上面的 sys.path 注入之后才能 import（与 indexer / config 同理）；
# 此前放在注入之前，ImportError 被静默吞掉，--repos 的「同步失败」提示整体失效。
# 仍然失败时不再静默：记录原因，由 --repos 分支向 stderr 明确报告。
_MIRROR_STATE_IMPORT_ERROR = None
try:
    from mirror_state import read_sync_state, sync_summary
except ImportError as _exc:
    read_sync_state = sync_summary = None
    _MIRROR_STATE_IMPORT_ERROR = str(_exc)

try:
    import indexer
except ImportError:
    indexer = None

try:
    from config import resolve_config
except ImportError:
    resolve_config = None

ROOT = ""
OWNER = ""
OWNERS = []
MIRROR = ""
SYNC = ""
GN = ["git", "-c", "core.pager=cat", "-c", "color.ui=false",
      # core.quotePath 默认 true：非 ASCII 路径会被转义成 "\345\257\274…"，
      # 中文文件名直接不可用（也读不出来）。必须显式关掉。
      "-c", "core.quotePath=false"]

# ── 平台感知的路径归一化 ────────────────────────────────────────────
# 背景：git tree object 内部一律以 "/" 作分隔符，所以从 Windows 传入的
# "docs\readme.md" 必须转成 "docs/readme.md" 才能被 git show 命中。
#
# 但反斜杠的语义在两套文件系统上完全相反：
#   - Windows (NTFS)："\" 是保留分隔符，文件名里不可能出现 → 见到即可安全转换
#   - POSIX (ext4/APFS/ext4)："\" 是**合法文件名字符**，"a\b.md" 是一个真实存在的
#     单文件名，Git 会如实保留它。无脑转换会把 "a\b.md" 变成 "a/b.md"，
#     于是 git show 静默返回另一个文件（"a/b.md"）的内容 —— 不报错、不告警。
#
# 因此归一化必须按平台分流，POSIX 侧保持路径原样。
IS_WINDOWS = os.name == "nt"


def normalize_git_path(p):
    """把用户传入的路径转成 git tree 内可定位的形式（平台感知）。"""
    s = str(p or "")
    if IS_WINDOWS:
        # Windows：反斜杠只可能是分隔符，转换安全
        s = s.replace("\\", "/")
    # POSIX：反斜杠是合法文件名字符，禁止转换；仅剥除首部 "/" 以对齐 git 的相对路径语义
    return s.lstrip("/")


def die(msg, code=2):
    print(f"gts: {msg}", file=sys.stderr)
    sys.exit(code)


_REPO_PART_RE = re.compile(r"^[A-Za-z0-9._-]+$")


def _repo_arg(repo):
    raw = str(repo or "").strip()
    if IS_WINDOWS:
        raw = raw.replace("\\", "/")
    parts = raw.split("/")
    if len(parts) not in (1, 2) or any(not p or p in (".", "..") or not _REPO_PART_RE.fullmatch(p) for p in parts):
        die(f"INVALID_REPO: 仓库名必须是 repo 或 owner/repo：{repo}")
    return parts


def all_repos():
    found_dir = False
    out = []
    for owner in OWNERS:
        mdir = os.path.join(ROOT, owner)
        if not os.path.isdir(mdir):
            continue
        found_dir = True
        for entry in os.listdir(mdir):
            if entry.endswith(".git") and os.path.isdir(os.path.join(mdir, entry)):
                out.append(f"{owner}/{entry[:-4]}")
    if not found_dir:
        die(f"镜像目录不存在：{MIRROR}（先跑 {SYNC}）")
    return sorted(out)


def resolve_repo(repo):
    parts = _repo_arg(repo)
    if len(parts) == 2:
        repo_id = "/".join(parts)
        if parts[0] not in OWNERS:
            die(f"镜像中不存在仓库：{repo_id}")
        gitdir = os.path.join(ROOT, parts[0], parts[1] + ".git")
        if not os.path.isdir(gitdir):
            die(f"镜像中不存在仓库：{repo_id}")
        return repo_id, gitdir
    candidates = [repo_id for repo_id in all_repos() if repo_id.rsplit("/", 1)[1] == parts[0]]
    if len(candidates) > 1:
        die(f"AMBIGUOUS_REPO: 裸仓名 {parts[0]} 匹配多个仓：{', '.join(candidates)}；请使用 owner/repo")
    if not candidates:
        die(f"镜像中不存在仓库：{parts[0]}")
    repo_id = candidates[0]
    owner, name = repo_id.split("/", 1)
    return repo_id, os.path.join(ROOT, owner, name + ".git")


def mirror_dir(repo):
    return resolve_repo(repo)[1]


def pick_repos(patterns):
    repos = all_repos()
    if not patterns:
        return repos
    pats = [p.strip() for chunk in patterns for p in chunk.split(",") if p.strip()]
    return [repo_id for repo_id in repos if any(fnmatch_any(repo_id, p) for p in pats)]


def fnmatch_any(name, pat):
    # 完整 owner/repo 模式匹配完整身份；旧的裸 repo 模式匹配 basename。
    norm_pat = (pat or "").replace("\\", "/") if IS_WINDOWS else (pat or "")
    target = name if "/" in norm_pat else name.rsplit("/", 1)[-1]
    nl, pl = target.lower(), norm_pat.lower()
    if any(ch in pl for ch in "*?["):
        return fnmatch.fnmatchcase(nl, pl)
    return pl in nl


def _git_error(stage, rc, message):
    text = str(message or "").strip() or f"git {stage} failed"
    return {"stage": stage, "rc": rc, "message": text[:500]}


def refs_of(gitdir, all_refs=False):
    prefix = "refs/" if all_refs else "refs/heads/"
    try:
        p = subprocess.run(
            GN + [f"--git-dir={gitdir}", "for-each-ref", "--format=%(refname:short)", prefix],
            capture_output=True, text=True,
        )
    except OSError as exc:
        return [], _git_error("refs", None, exc)
    if p.returncode != 0:
        return [], _git_error("refs", p.returncode, p.stderr)
    return [l for l in p.stdout.splitlines() if l.strip()], None


def _stream(cmd, cap, stage, ok_rcs=(0,)):
    """逐行读取 stdout；返回 (lines, capped, error)，并保留 Git 的退出语义。"""
    with tempfile.TemporaryFile() as stderr_file:
        try:
            p = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=stderr_file)
        except OSError as exc:
            return [], False, _git_error("spawn", None, exc)

        lines, capped, killed = [], False, False
        read_error = None
        try:
            for raw in p.stdout:
                # 逐行读取时行终止符可能是 "\n"(LF) 或 "\r\n"(CRLF)，两种都要剥除。
                # 注意不能用 rstrip("\r\n")：那会把行内容尾部的其它 CR 一并吃掉。
                s = raw.decode("utf-8", "replace")
                if s.endswith("\n"):
                    s = s[:-1]
                if s.endswith("\r"):
                    s = s[:-1]
                lines.append(s)
                if len(lines) >= cap:
                    capped = True
                    if p.poll() is None:
                        p.kill()
                        killed = True
                    break
        except (OSError, ValueError) as exc:
            read_error = exc
        finally:
            if p.stdout is not None:
                p.stdout.close()

        wait_error = None
        try:
            p.wait(timeout=5)
        except subprocess.TimeoutExpired as exc:
            wait_error = exc
            if p.poll() is None:
                p.kill()
            p.wait()

        stderr_file.seek(0)
        stderr = stderr_file.read().decode("utf-8", "replace")
        if read_error is not None:
            return lines, capped, _git_error(stage, p.returncode, read_error)
        if wait_error is not None:
            return lines, capped, _git_error(stage, p.returncode, wait_error)
        if not killed and p.returncode not in ok_rcs:
            return lines, capped, _git_error(stage, p.returncode, stderr)
        return lines, capped, None


def split_grep(line, ref):
    """git grep 输出：<ref>:<path>:<lineno>:<text>"""
    body = line[len(ref) + 1:] if line.startswith(ref + ":") else line
    path, _, rest = body.partition(":")
    lineno, _, text = rest.partition(":")
    return path, lineno, text


def search_repo(repo, a, and_words=None):
    """返回 (records, capped, error)；repo 是 canonical owner/repo。"""
    owner, name = repo.split("/", 1)
    gitdir = os.path.join(ROOT, owner, name + ".git")
    rl, error = refs_of(gitdir, a.all_refs)
    if error:
        return [], False, error
    if a.branch:
        want = a.branch.split(",")
        if any(w.upper() == "HEAD" for w in want):
            try:
                p = subprocess.run(GN + [f"--git-dir={gitdir}", "symbolic-ref", "--short", "HEAD"],
                                   capture_output=True, text=True)
            except OSError as exc:
                return [], False, _git_error("symbolic-ref", None, exc)
            if p.returncode not in (0, 1):
                return [], False, _git_error("symbolic-ref", p.returncode, p.stderr)
            head = p.stdout.strip()
            want = [w for w in want if w.upper() != "HEAD"] + ([head] if head else [])
        rl = [r for r in rl if any(fnmatch_any(r, w) for w in want)]
    if not rl:
        return [], False, None
    recs, capped = [], False
    # 每仓收集上限：内容模式给足余量但仍设闸（防超宽模式打满内存）。
    # 计数模式单独走精确计数（只数不存），不受这个闸影响——否则 -c 的排行会失真。
    per_cap = max(500, a.max * 5)
    if a.files:
        per_cap = 5000

    pattern_args = ["-e", a.pattern]
    if and_words and len(and_words) >= 2:
        pattern_args = []
        for idx, w in enumerate(and_words):
            if idx > 0:
                pattern_args.append("--and")
            pattern_args += ["-e", w]

    for ref in rl:
        if a.mode == "content":
            if a.count:
                cmd = GN + [f"--git-dir={gitdir}", "grep", "-n", "-I", "--no-color"]
                if not a.case_sensitive:
                    cmd.append("-i")
                cmd.append("-E" if (a.regex and not and_words) else "-F")
                if a.word:
                    cmd.append("-w")
                cmd += pattern_args + [ref]
                out, cap, error = _stream(cmd, 500000, "grep", ok_rcs=(0, 1))
                capped = capped or cap
                if error:
                    return recs, capped, error
                recs.append((repo, ref, "", "", str(len(out))))
                continue
            cmd = GN + [f"--git-dir={gitdir}", "grep", "-n", "-I", "--no-color"]
            if not a.case_sensitive:
                cmd.append("-i")
            cmd.append("-E" if (a.regex and not and_words) else "-F")
            if a.word:
                cmd.append("-w")
            if a.files:
                cmd.append("-l")
            cmd += pattern_args + [ref]
            out, cap, error = _stream(cmd, per_cap, "grep", ok_rcs=(0, 1))
            capped = capped or cap
            if error:
                return recs, capped, error
            for line in out:
                path, lineno, text = split_grep(line, ref)
                recs.append((repo, ref, path, lineno, text))
        elif a.mode == "path":
            cmd = GN + [f"--git-dir={gitdir}", "ls-tree", "-r", "--name-only", ref]
            out, cap, error = _stream(cmd, 200000, "ls-tree")
            capped = capped or cap
            if error:
                return recs, capped, error
            if a.regex:
                try:
                    rx = re.compile(a.pattern, 0 if a.case_sensitive else re.I)
                except re.error as e:
                    die(f"正则不合法：{e}")
                hits = [l for l in out if rx.search(l)]
            else:
                needle = a.pattern if a.case_sensitive else a.pattern.lower()
                hits = [l for l in out if needle in (l if a.case_sensitive else l.lower())]
            for h in hits[:per_cap]:
                recs.append((repo, ref, h, "", ""))
            if len(hits) > per_cap:
                capped = True
        else:  # message
            cmd = GN + [f"--git-dir={gitdir}", "log", ref, "--no-color",
                        "--date=short", "--format=%h\t%ad\t%s"]
            out, cap, error = _stream(cmd, 200000, "log")
            capped = capped or cap
            if error:
                return recs, capped, error
            try:
                rx = re.compile(a.pattern, 0 if a.case_sensitive else re.I)
            except re.error as e:
                die(f"正则不合法：{e}")
            for line in out:
                parts = line.split("\t", 2)
                if len(parts) < 3:
                    continue
                h, d, subj = parts
                target = subj if a.regex else (f"{d} {subj}")
                if (rx.search(subj) if a.regex else
                        (a.pattern.lower() in target.lower() if not a.case_sensitive
                         else a.pattern in target)):
                    recs.append((repo, "-", h, d, subj))
                    if len(recs) >= per_cap:
                        capped = True
                        break
    return recs, capped, None


def fmt_text(recs, a, stats):
    lines = []
    total = 0
    if a.count:
        per = {}
        for r in recs:
            per[r[0]] = per.get(r[0], 0) + (int(r[4]) if r[4].isdigit() else 0)
        for repo, n in sorted(per.items(), key=lambda kv: (-kv[1], kv[0])):
            lines.append(f"{n:6d}  {repo}")
        total = sum(int(r[4]) for r in recs if r[4].isdigit())
    elif a.files:
        seen = []
        seen_set = set()
        for r in recs:
            key = (r[0], r[1], r[2])
            if key not in seen_set:
                seen_set.add(key)
                seen.append(key)
        for repo, ref, path in seen:
            lines.append(f"{repo}@{ref}:{path}")
        total = len(seen)
    else:
        seen = set()
        for repo, ref, path, lineno, text in recs:
            if a.mode == "content":
                s = f"{repo}@{ref}:{path}:{lineno}:{text}"
            elif a.mode == "path":
                s = f"{repo}@{ref}:{path}"
            else:
                s = f"{repo} {path} {lineno} {text}"
            if s in seen:
                continue
            seen.add(s)
            lines.append(s)
        total = len(lines)

    unit = {"content": "行", "path": "个路径", "message": "条提交"}[a.mode]
    if a.count:
        unit = "行"
    out = lines[: a.max]
    ge = "≥ " if stats["capped"] else ""
    fb_note = "；原短语 0 命中，已自动回退为同行多词 AND 匹配" if stats.get("fallback_and") else ""
    foot = [f"—— 命中 {ge}{total} {unit} / {stats['repos_hit']} 个仓"
            f"（{stats['repos_total']} 个镜像仓，{stats['elapsed']:.1f}s{fb_note}）"]
    if len(lines) > a.max:
        foot.append(f"（已截断显示到 {a.max} 行；用 -r <仓名> 或更精确的模式收窄）")
    if stats["capped"]:
        foot.append("（有仓触顶，总数是下界）")
    if stats.get("errors"):
        foot.append(f"（GIT_SEARCH_FAILED: {stats['repos_failed']} 个仓搜索失败；上述结果可能不完整）")
    elif total == 0 and a.mode == "content":
        foot.append("（提示：若需跨行多词组合或中文分词检索文档/历史会话，请用 `gts -D \"<关键词>\"` 或 MCP `search_gitea_docs`）")
    out.append("")
    out.extend(foot)
    return "\n".join(out)


def fmt_json(recs, a, stats):
    results = []
    seen = set()
    for repo, ref, path, lineno, text in recs:
        key = (repo, ref, path, lineno, text)
        if key in seen:
            continue
        seen.add(key)
        if a.mode == "content":
            results.append({"repo": repo, "ref": ref, "path": path,
                            "line": int(lineno) if lineno.isdigit() else None, "text": text})
        elif a.mode == "path":
            results.append({"repo": repo, "ref": ref, "path": path})
        else:
            results.append({"repo": repo, "commit": path, "date": lineno, "subject": text})
    results.sort(key=lambda r: (r.get("repo", ""), r.get("path", ""), r.get("line") or 0))
    payload = {
        "pattern": a.pattern,
        "mode": a.mode,
        "match_mode": "line_and_fallback" if stats.get("fallback_and") else ("regex" if a.regex else "literal"),
        "total": len(results),
        "truncated": len(results) > a.max or stats["capped"],
        "complete": not stats["errors"],
        "repos_scanned": stats["repos_total"] - stats["repos_failed"],
        "repos_failed": stats["repos_failed"],
        "repos_hit": stats["repos_hit"],
        "mirror_last_sync": stats["last_sync"],
        "errors": stats["errors"],
        "results": results[: a.max],
    }
    return json.dumps(payload, ensure_ascii=False, indent=1)


def read_last_sync():
    p = os.path.join(ROOT, "last_sync")
    if os.path.exists(p):
        try:
            return open(p).read().strip()
        except OSError:
            pass
    return None


def _force_utf8_stdio():
    """把 stdout/stderr 切到 UTF-8，避免 Windows 上用非 UTF-8 代码页时直接崩。

    2026-10-28 实测（GitHub windows-latest）：本脚本的帮助文本、错误信息、检索结果
    全是中文，而 Windows 控制台默认是 cp1252/cp437（locale.getpreferredencoding()）。
    `gts --help` 在 argparse 打印 help 时就抛

        UnicodeEncodeError: 'charmap' codec can't encode character '\u8de8'

    —— 也就是说 **Windows 用户装好后第一次运行就必崩**，与检索是否可用无关。
    这里在入口处显式 reconfigure（Python 3.7+ 的 TextIOWrapper.reconfigure），
    并对 errors 放宽到 backslashreplace，保证极端情况下也只是显示转义而不是抛异常。
    注意：这不影响管道/重定向场景（重定向时 Python 用 locale 编码，同样需要它）。
    """
    for stream in (sys.stdout, sys.stderr):
        if stream is None:
            continue
        # 已经是 UTF-8 就不动它（用户显式配对了就尊重；也避免多一次无谓 reconfigure）。
        enc = (getattr(stream, "encoding", None) or "").lower().replace("-", "").replace("_", "")
        if enc in ("utf8", "utf8mb4"):
            continue
        rc = getattr(stream, "reconfigure", None)
        if rc is None:
            continue
        try:
            # 关键：即使 PYTHONIOENCODING 被设成 ascii/cp1252，也必须覆盖它。
            # 实测（ams2 模拟 CPython + ascii）：仅靠「检测到 PYTHONIOENCODING 就跳过」，
            # gts --help 依旧在 argparse 打印中文 help 时抛 UnicodeEncodeError / 退出码 120。
            # errors 再用 backslashreplace 兜底，保证任何残余不可编码字符只是显示为转义，
            # 而不是把整个 CLI 崩掉。
            rc(encoding="utf-8", errors="backslashreplace")
        except (ValueError, OSError):
            # 某些受限 stdio 包装器不支持 reconfigure —— 宁可不动，不要因此在启动期崩掉。
            pass


def main():
    global ROOT, OWNER, OWNERS, MIRROR, SYNC
    _force_utf8_stdio()
    ap = argparse.ArgumentParser(add_help=True, description="跨 gitea 全量镜像搜索")
    ap.add_argument("pattern", nargs="?", help="搜索模式")
    ap.add_argument("-q", "--query", dest="query_alias", help="搜索模式（别名）")
    ap.add_argument("-p", "--path", dest="mode", action="store_const", const="path",
                    help="搜文件路径（而不是内容）")
    ap.add_argument("-m", "--msg", "--messages", dest="mode", action="store_const", const="message",
                    help="搜提交信息")
    ap.add_argument("-E", "--regex", action="store_true", help="pattern 按扩展正则解释")
    ap.add_argument("-s", "--case-sensitive", action="store_true", help="区分大小写")
    ap.add_argument("-w", "--word", action="store_true", help="全词匹配（仅内容模式）")
    ap.add_argument("-l", "--files", action="store_true", help="只列命中文件")
    ap.add_argument("-c", "--count", action="store_true", help="每仓命中数排行")
    ap.add_argument("-r", "--repo", action="append", default=[], help="限定仓（可重复/逗号分隔/支持 *）")
    ap.add_argument("-b", "--branch", default=None, help="限定分支（默认全部分支；HEAD=默认分支）")
    ap.add_argument("-A", "--all-refs", action="store_true", help="连 tags 一起搜")
    ap.add_argument("-D", "--doc", "--session", dest="doc_mode", action="store_true",
                    help="使用 SQLite FTS5 毫秒级全文检索文档与会话")
    ap.add_argument("--kind", default=None,
                    help="按内容类型过滤（逗号分隔）：doc/session/config/script")
    ap.add_argument("--reindex", action="store_true", help="增量更新文档与会话 FTS5 索引")
    ap.add_argument("--full", action="store_true", help="配合 --reindex 安全全量重建 owner-aware 索引")
    ap.add_argument("--fts-stats", action="store_true", help="查看 FTS5 索引库统计信息")
    ap.add_argument("--perf-stats", action="store_true", help="查看性能与磁盘 I/O 监测统计")
    ap.add_argument("--doctor", action="store_true", help="运行索引与宿主 DSH 会话健康及 I/O 诊断")
    ap.add_argument("--config", default=None, help="显式配置文件路径（优先于用户/项目 config.json）")
    ap.add_argument("--mirror-root", default=None, help="显式镜像根目录（最高优先级）")
    ap.add_argument("--owners", default=None, help="显式 owner 列表，逗号分隔（最高优先级）")
    ap.add_argument("--show-effective-config", action="store_true", help="显示最终配置及来源，不输出 token")
    ap.add_argument("--dsh-home", default=None, help="指定宿主 .dsh 目录路径（供 --doctor 检查）")
    ap.add_argument("--read", dest="read_path", default=None, help="直接读取指定仓(-r)内的文件内容")
    ap.add_argument("-n", "--max", "--limit", dest="max", type=int, default=200, help="最多输出行数（默认 200）")
    ap.add_argument("-j", "--jobs", type=int, default=8, help="并发仓数（默认 8）")
    ap.add_argument("--json", action="store_true", help="JSON 输出")
    ap.add_argument("--sync", action="store_true", help="搜索前先增量同步镜像")
    ap.add_argument("--repos", action="store_true", help="只列出镜像里的仓")
    a = ap.parse_args()
    a.mode = a.mode or "content"
    if a.query_alias and not a.pattern:
        a.pattern = a.query_alias

    if resolve_config is None:
        die("未找到共享配置模块 lib/config.py")
    try:
        effective = resolve_config(
            cli_root=a.mirror_root,
            cli_owners=a.owners,
            config_path=a.config,
            project_dir=os.path.normpath(os.path.join(_CUR_DIR, "..")),
        )
    except ValueError as exc:
        die(f"CONFIG_ERROR: {exc}")
    ROOT = effective["mirror_root"]
    OWNERS = effective["owners"]
    OWNER = ",".join(OWNERS)
    MIRROR = os.path.join(ROOT, OWNERS[0]) if OWNERS else ROOT
    SYNC = os.path.join(os.path.dirname(_CUR_DIR), "scripts", "sync.sh")
    if a.show_effective_config:
        print(json.dumps(effective, ensure_ascii=False, indent=2))
        for warning in effective.get("warnings", []):
            print("CONFIG_WARNING: " + warning, file=sys.stderr)
        if not effective["valid"]:
            print("CONFIG_ERROR: " + "; ".join(effective["errors"]), file=sys.stderr)
        return
    if not effective["valid"]:
        die("CONFIG_ERROR: " + "; ".join(effective["errors"]))

    if a.sync:
        if len(OWNERS) != 1:
            die("CONFIG_ERROR: --sync currently supports exactly one owner; "
                "sync each owner separately with --owners before searching multiple owners")
        if not os.path.exists(SYNC):
            die(f"同步脚本不存在：{SYNC}")
        bash_bin = "/bin/bash" if os.path.exists("/bin/bash") else (shutil.which("bash") or "bash")
        try:
            # sync.sh does not read JSON or CLI options. Pass the resolved values,
            # rather than letting it fall back to another directory/owner.
            sync_env = dict(os.environ, GITEA_MIRROR_ROOT=ROOT, GITEA_OWNERS=OWNER)
            sync_result = subprocess.run(
                [bash_bin, SYNC, "-q"], check=False, env=sync_env,
                stderr=subprocess.PIPE, text=True, errors="replace",
            )
            sync_stderr = sync_result.stderr or ""
            if sync_stderr:
                print(sync_stderr, end="" if sync_stderr.endswith("\n") else "\n", file=sys.stderr)
            if sync_result.returncode != 0:
                index_failure = re.search(r"(?:^|\n)INDEX_UPDATE_FAILED:[^\n]*\brc=(\d+)\b", sync_stderr)
                if index_failure:
                    die(f"INDEX_UPDATE_FAILED: 索引更新失败 rc={index_failure[1]}",
                        code=sync_result.returncode or 1)
                die(f"SYNC_FAILED: 同步脚本退出码 {sync_result.returncode}", code=sync_result.returncode or 1)
        except Exception as e:
            die(f"执行同步失败：{e}（Windows 环境建议通过 PowerShell 执行 scripts\\setup-windows.ps1 或 git 镜像拉取）")

    if a.doctor:
        if not indexer:
            die("未找到 indexer 模块，无法运行健康诊断")
        print(indexer.run_doctor(ROOT, dsh_home=a.dsh_home, as_json=a.json))
        return

    if a.perf_stats:
        if not indexer:
            die("未找到 indexer 模块，无法查看性能与 I/O 统计")
        print(indexer.get_perf_stats(ROOT, limit=a.max or 100, as_json=a.json))
        return

    if a.fts_stats:
        if not indexer:
            die("未找到 indexer 模块，无法查看索引统计")
        print(indexer.get_stats(ROOT))
        return

    if a.repos:
        if read_sync_state and sync_summary:
            state = read_sync_state(ROOT)
            if state["status"] in {"unrecorded", "invalid", "failed"}:
                print("镜像同步状态: " + sync_summary(state), file=sys.stderr)
        else:
            print(f"警告：无法导入 mirror_state 模块（{_MIRROR_STATE_IMPORT_ERROR}），"
                  "无法判定镜像同步状态；『最近同步失败』等提示在本次 --repos 中不可用。", file=sys.stderr)

    if a.read_path:
        if not a.repo:
            die("使用 --read 时必须通过 -r 指定仓库名")
        repo_id, gd = resolve_repo(a.repo[0])
        ref = a.branch or "HEAD"
        clean_rel_path = normalize_git_path(a.read_path)
        p = subprocess.run(GN + [f"--git-dir={gd}", "show", f"{ref}:{clean_rel_path}"], capture_output=True, text=True)
        if p.returncode != 0:
            die(p.stderr.strip() or f"无法读取 {a.repo[0]}@{ref}:{a.read_path}", code=1)
        sys.stdout.write(p.stdout)
        return

    if a.reindex:
        if not indexer:
            die("未找到 indexer 模块，无法构建索引")
        repo_filter = ",".join(a.repo) if a.repo else None
        indexer.build_index(ROOT, OWNER, repo_filter=repo_filter, full=a.full, verbose=not a.json)
        return

    if a.doc_mode:
        if not indexer:
            die("未找到 indexer 模块，无法执行文档检索")
        if not a.pattern:
            ap.error("使用 -D/--doc 时需要一个搜索模式")
        # 当用户显式传入 -r/--repo 但镜像中没有任何仓匹配时，属于“范围过滤后 0 命中”而非系统故障。
        # 若直接进 SQLite 或 die()，要么丢掉“仓名不在镜像”提示，要么无 JSON 输出导致 MCP 报 UNKNOWN_FAILURE。
        if a.repo and not pick_repos(a.repo):
            note_msg = "REPO_NOT_IN_MIRROR: 镜像里没有匹配该 -r 的仓；用 gts --repos 查看可用仓名"
            if a.json:
                print(json.dumps({
                    "total": 0,
                    "results": [],
                    "repos_hit": 0,
                    "repos_scanned": 0,
                    "repo_unmatched": list(a.repo),
                    "note": note_msg,
                }, ensure_ascii=False, indent=1))
            else:
                print("REPO_NOT_IN_MIRROR: 镜像里没有匹配该 -r 的仓（--repos 查看镜像里有哪些仓）")
            sys.exit(0)
        repo_filter = ",".join(a.repo) if a.repo else None
        res = indexer.search_fts(ROOT, a.pattern, repo=repo_filter, limit=a.max, kind=a.kind)
        if a.json:
            # JSON 模式下仍将含 error 的结构打到 stdout，但以 rc=1 退出：
            # MCP server.mjs 依赖 stdout JSON 解析 + 非零退出码双信号走 failureResult 归因（如 DEPENDENCY_MISSING）。
            print(json.dumps(res, ensure_ascii=False, indent=1))
            if "error" in res:
                sys.exit(1)
        else:
            if "error" in res:
                die(res["error"])
            hits = res.get("results", [])
            for r in hits:
                print(f"[{r['repo']}@{r['ref']}] {r['path']} ({r['title']})")
                print(f"  {r['snippet']}\n")
            print(f"—— 命中 {len(hits)} 篇文档（FTS5 相关度排序）")
        return

    if a.repos:
        rl = pick_repos(a.repo)
        if a.json:
            print(json.dumps({"owner": OWNER, "count": len(rl), "repos": rl,
                              "mirror_last_sync": read_last_sync()}, ensure_ascii=False, indent=1))
        else:
            for r in rl:
                print(r)
            print(f"\n共 {len(rl)} 个仓；镜像 last_sync: {read_last_sync() or '未知'}")
        return

    if not a.pattern:
        ap.error("需要一个搜索模式（或 --repos）")

    repos = pick_repos(a.repo)
    if not repos:
        # 显式给了 -r/--repo 但没有任何镜像仓匹配时，遵守“0 命中不是失败”契约返回 rc=0 与结构化提示，
        # 避免 die() 只写 stderr 无 JSON 导致上层 MCP 解析失败误报 UNKNOWN_FAILURE。
        if a.repo:
            note_msg = "REPO_NOT_IN_MIRROR: 镜像里没有匹配该 -r 的仓；用 gts --repos 查看可用仓名"
            if a.json:
                print(json.dumps({
                    "total": 0,
                    "results": [],
                    "repos_hit": 0,
                    "repos_scanned": 0,
                    "repo_unmatched": list(a.repo),
                    "note": note_msg,
                }, ensure_ascii=False, indent=1))
            else:
                print("REPO_NOT_IN_MIRROR: 镜像里没有匹配该 -r 的仓（--repos 查看镜像里有哪些仓）")
            sys.exit(0)
        die("没有匹配的仓（--repos 看看有哪些）", 1)

    t0 = time.time()
    recs, errors, capped = [], [], False
    fallback_and = False

    def collect(results):
        nonlocal capped
        for repo, (rr, cap, error) in zip(repos, results):
            recs.extend(rr)
            capped = capped or cap
            if error:
                item = {"repo": repo, **error}
                errors.append(item)
                rc = "unknown" if item["rc"] is None else item["rc"]
                print(f"GIT_SEARCH_FAILED: {repo}: {item['stage']} rc={rc}: {item['message']}",
                      file=sys.stderr)

    with ThreadPoolExecutor(max_workers=a.jobs) as ex:
        collect(ex.map(lambda r: search_repo(r, a), repos))

    # 只有完整的首轮干净 0 命中才执行同行多词回退；失败仓不能被第二轮结果掩盖。
    if not recs and not errors and a.mode == "content" and not a.regex:
        words = [w for w in re.split(r"\s+", a.pattern.strip()) if w]
        if len(words) >= 2:
            fallback_and = True
            with ThreadPoolExecutor(max_workers=a.jobs) as ex:
                collect(ex.map(lambda r: search_repo(r, a, and_words=words), repos))

    errors.sort(key=lambda item: (item["repo"], item["stage"], item["rc"] is None,
                                  item["rc"] if item["rc"] is not None else 0))
    stats = {
        "repos_total": len(repos),
        "repos_hit": len({r[0] for r in recs}),
        "repos_failed": len({error["repo"] for error in errors}),
        "errors": errors,
        "elapsed": time.time() - t0,
        "capped": capped,
        "fallback_and": fallback_and,
        "last_sync": read_last_sync(),
    }
    if a.json:
        print(fmt_json(recs, a, stats))
    else:
        print(fmt_text(recs, a, stats))
    sys.exit(2 if errors else (0 if recs else 1))


if __name__ == "__main__":
    main()
